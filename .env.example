# Required to enable the optional AI model. The app also runs in deterministic demo mode without it.
AI_API_TOKEN=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
PORT=8080

# Optional real email delivery. Without SMTP_HOST, consent records a demo outbox entry.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=claims@example.test
